+    def sample_from_noise(self, z, cond, returns=None):
+        '''
+            Differentiable, deterministic version of p_sample_loop (no projector):
+            the output is a fixed function Psi_c(z) of the noise z, where
+                z : [ batch x (n_timesteps + 1) x horizon x transition_dim ] ~ N(0, I)
+            z[:, 0] is the initial iterate x_K and z[:, K - i] is the noise injected after reverse step i
+            (z[:, K] is unused, since no noise is added at t = 0). Same noise scaling as p_sample_loop.
+        '''
+        K = self.n_timesteps
+        b = z.shape[0]
+        x = NOISE_SCALE * z[:, 0]
+        x = apply_conditioning(x, cond, self.action_dim, goal_dim=self.goal_dim)
+        for i in reversed(range(K)):
